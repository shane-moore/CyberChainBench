# Public, keyless RPC endpoints — committed fallback defaults.
#
# Loaded by infra.chain.metadata._load_local_rpc_defaults() ONLY to fill gaps
# left by your local .env (which is authoritative and overrides these).
#
# Rules for this file:
#   - ONLY public endpoints that need no API key may live here (it is in git).
#   - NEVER put Alchemy/Infura/QuickNode keyed URLs or any secret here — those
#     belong in .env (gitignored). See .env.example.
#
# Coverage note: these are full-node public endpoints, fine for eth_call and
# recent reads. They generally do NOT support archive history or
# debug_traceTransaction. Fork/replay and *_TRACE_RPC_URL must be set in .env
# to a keyed archive node. Ethereum mainnet has no reliable keyless archive
# node, so ETH_RPC_URL is intentionally left to .env as well.

BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpc.ftm.tools
GNOSIS_RPC_URL=https://rpc.gnosischain.com
